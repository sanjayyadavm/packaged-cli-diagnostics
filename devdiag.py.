

import argparse
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "1.0"

SUCCESS = 0
MISSING_DEPENDENCY = 1
MALFORMED_CONFIGURATION = 2

DEFAULT_TOOLS = [
    "git",
    "python",
    "pip",
    "node",
    "npm",
    "docker",
]

def check_python():
    "Check Python version."

    version = platform.python_version()

    return {
        "name": "python",
        "status": "pass",
        "message": f"Python {version}",
        "details": {
            "version": version,
            "implementation": platform.python_implementation(),
            "executable": sys.executable,
        },
    }
def check_disk_space(path=".", minimum_free_gb=1.0):
    "Check available disk space."

    try:
        usage = shutil.disk_usage(path)
        free_gb = usage.free / (1024 ** 3)
        total_gb = usage.total / (1024 ** 3)

        status = "pass" if free_gb >= minimum_free_gb else "fail"

        return {
            "name": "disk_space",
            "status": status,
            "message": f"{free_gb:.2f} GB free",
            "details": {
                "path": os.path.abspath(path),
                "free_gb": round(free_gb, 2),
                "total_gb": round(total_gb, 2),
                "minimum_free_gb": minimum_free_gb,
            },
        }

    except OSError as error:
        return {
            "name": "disk_space",
            "status": "fail",
            "message": str(error),
            "details": {},
        }
def check_environment(required_variables):
    "Check required environment variables."

    required_variables = sorted(required_variables)

    missing = [
        variable
        for variable in required_variables
        if not os.environ.get(variable)
    ]

    if missing:
        status = "fail"
        message = (
            "Missing environment variables: "
            + ", ".join(missing)
        )
    else:
        status = "pass"
        message = "All required environment variables are present"

    return {
        "name": "environment",
        "status": status,
        "message": message,
        "details": {
            "required": required_variables,
            "missing": missing,
        },
    }


def get_tool_version(executable):
    "Get the version of a developer tool."

    try:
        result = subprocess.run(
            [executable, "--version"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )

        output = (
            result.stdout.strip()
            or result.stderr.strip()
        )

        if output:
            return output.splitlines()[0]

    except (
        OSError,
        subprocess.SubprocessError,
    ):
        pass

    return ""


def check_developer_tools(tools):
    "Check configured developer tools."

    results = {}
    missing = []

    for tool in sorted(tools):
        executable = shutil.which(tool)

        if executable is None:
            results[tool] = {
                "status": "missing",
                "path": "",
                "version": "",
            }
            missing.append(tool)

        else:
            results[tool] = {
                "status": "available",
                "path": executable,
                "version": get_tool_version(executable),
            }

    if missing:
        status = "fail"
        message = "Missing tools: " + ", ".join(missing)
    else:
        status = "pass"
        message = "All configured developer tools are available"

    return {
        "name": "developer_tools",
        "status": status,
        "message": message,
        "details": {
            "tools": results,
            "missing": missing,
        },
    }


def load_config(config_path):
    "Load and validate JSON configuration."

    path = Path(config_path)

    if not path.exists():
        raise ValueError(
            f"Configuration file does not exist: {config_path}"
        )

    if not path.is_file():
        raise ValueError(
            f"Configuration path is not a file: {config_path}"
        )

    try:
        with path.open("r", encoding="utf-8") as file:
            config = json.load(file)

    except json.JSONDecodeError as error:
        raise ValueError(
            f"Malformed JSON configuration: {error}"
        ) from error

    if not isinstance(config, dict):
        raise ValueError(
            "Configuration must contain a JSON object"
        )

    return config


def build_report(config):
    "Build the complete diagnostic report."

    required_environment = config.get(
        "required_environment",
        [],
    )

    tools = config.get(
        "tools",
        DEFAULT_TOOLS,
    )

    disk_path = config.get(
        "disk_path",
        ".",
    )

    minimum_free_gb = config.get(
        "minimum_free_gb",
        1.0,
    )

    diagnostics = [
        check_python(),
        check_disk_space(
            disk_path,
            minimum_free_gb,
        ),
        check_environment(
            required_environment,
        ),
        check_developer_tools(
            tools,
        ),
    ]

    failures = [
        diagnostic
        for diagnostic in diagnostics
        if diagnostic["status"] == "fail"
    ]

    if failures:
        overall_status = "unhealthy"
        exit_code = MISSING_DEPENDENCY
    else:
        overall_status = "healthy"
        exit_code = SUCCESS

    return {
        "version": VERSION,
        "overall_status": overall_status,
        "exit_code": exit_code,
        "diagnostics": diagnostics,
    }


def print_text_report(report):
    "Print human-readable report."

    print()
    print("Developer Environment Health Report")
    print("===================================")
    print(f"Status: {report['overall_status']}")
    print(f"Exit code: {report['exit_code']}")
    print()

    for diagnostic in report["diagnostics"]:
        print(
            f"[{diagnostic['status'].upper()}] "
            f"{diagnostic['name']}: "
            f"{diagnostic['message']}"
        )

        details = diagnostic["details"]

        for key, value in details.items():

            if isinstance(value, dict):
                print(f"  {key}:")

                for child_key in sorted(value):
                    print(
                        f"    {child_key}: "
                        f"{value[child_key]}"
                    )

            else:
                print(f"  {key}: {value}")

        print()


def main():
    "Main CLI function."

    parser = argparse.ArgumentParser(
        description=(
            "Developer Environment Diagnostics Tool"
        )
    )

    parser.add_argument(
        "--config",
        help="Path to JSON configuration file",
    )

    parser.add_argument(
        "--format",
        choices=["text", "json"],
        default="text",
        help="Output format",
    )

    args = parser.parse_args()

    config = {}

    # Load configuration
    if args.config:

        try:
            config = load_config(args.config)

        except ValueError as error:

            if args.format == "json":

                print(
                    json.dumps(
                        {
                            "version": VERSION,
                            "overall_status":
                                "invalid_configuration",
                            "exit_code":
                                MALFORMED_CONFIGURATION,
                            "error": str(error),
                        },
                        indent=2,
                        sort_keys=True,
                    )
                )

            else:

                print(
                    f"Configuration error: {error}",
                    file=sys.stderr,
                )

            return MALFORMED_CONFIGURATION

    # Generate report
    report = build_report(config)

    # Output
    if args.format == "json":

        print(
            json.dumps(
                report,
                indent=2,
                sort_keys=True,
            )
        )

    else:

        print_text_report(report)

    return report["exit_code"]


if __name__ == "__main__":
    (main())